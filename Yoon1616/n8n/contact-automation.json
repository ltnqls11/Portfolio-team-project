        "functionCode": "const out = [];\nfor (const item of items) {\n  const okEmail = $item(0).$node[\"Gmail: Send Email\"]?.context?.execution?.lastNodeExecuted === 'Gmail: Send Email' ? ($item(0).$node[\"Gmail: Send Email\"].context.data?.main?.[0]?.[0]?.json || null) : null;\n  out.push({ json: { influencerId: item.json.influencerId, emailSent: item.json.sendEmail || false, dmSent: item.json.sendDM || false } });\n}\nreturn out;"
      },
