      "name": "Webhook: Update Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [280, 560]
    },
    {
      "parameters": {
        "functionCode": "const { influencerId, status } = items[0].json;\nconst allowed = ['대기','전송','회신','수락','거절'];\nif (!influencerId || !allowed.includes(status)) throw new Error('influencerId and valid status required');\nreturn items;"
      },
      "id": "ValidateStatus",
      "name": "Function: Validate Status",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [540, 560]
    },
    {
      "parameters": {
        "query": "UPDATE contacts SET status='{{{$json[\"status\"]}}}', response_at = CASE WHEN '{{{$json[\"status\"]}}}' IN ('회신','수락','거절') THEN NOW() ELSE response_at END WHERE influencer_id='{{{$json[\"influencerId\"]}}}' ORDER BY sent_at DESC LIMIT 1;"
      },
