    {
      "parameters": {
        "functionCode": "const { influencerIds = [], method = 'email', message = '', campaign = {} } = items[0].json || {};\nif (!Array.isArray(influencerIds) || influencerIds.length === 0) {\n  throw new Error('influencerIds is required (array)');\n}\nconst sendEmail = method === 'email' || method === 'both';\nconst sendDM = method === 'dm' || method === 'both';\nreturn influencerIds.map((id) => ({ json: { influencerId: id, method, sendEmail, sendDM, message, campaign } }));"
      },
      "id": "ExplodeItems",
      "name": "Function: Explode Influencers",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [540, 240]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, email, instagram_id FROM influencers WHERE id = '={{$json[\"influencerId\"]}}' LIMIT 1;"
      },
      "id": "FetchInfluencer",
      "name": "Postgres: Fetch Influencer",
      "type": "n8n-nodes-base.postgres",
