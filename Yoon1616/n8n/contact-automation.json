    {
      "parameters": {
        "functionCode": "const row = (items[0].json && items[0].json.rows && items[0].json.rows[0]) || null;\nif (!row) throw new Error('Influencer not found');\nreturn [{ json: { ...$json, name: row.name, email: row.email, instagram_id: row.instagram_id } }];"
      },
