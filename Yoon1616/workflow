{
  "name": "인플루언서_연락_자동화",
  "nodes": [
    {
      "parameters": {},
      "name": "시작_웹훅",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "id": "1",
      "when": "manually",
      "executionType": "manual"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": [
          {
            "name": "influencerName",
            "value": "={{$json.name}}"
          },
          {
            "name": "influencerId",
            "value": "={{$json.id}}"
          },
          {
            "name": "contactMethod",
            "value": "={{$json.contactMethod}}"
          },
          {
            "name": "contactEmail",
            "value": "={{$json.email}}"
          }
        ]
      },
      "name": "웹훅_데이터_설정",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "id": "2"
    },
    {
      "parameters": {
        "fromEmail": "your-email@gmail.com",
        "toEmail": "={{$node['웹훅_데이터_설정'].json['contactEmail']}}",
        "subject": "={{$node['웹훅_데이터_설정'].json['influencerName']}}님, 안녕하세요! 협업 제안드립니다.",
        "text": "안녕하세요 {{$node['웹훅_데이터_설정'].json['influencerName']}}님. \n\n저희는 {회사명}이며, {제품/서비스}와 관련하여 협업을 제안드립니다. \n\n자세한 내용은 추후 논의 가능하니, 회신 부탁드립니다. \n\n감사합니다.\n\n{담당자 이름}",
        "authentication": "oAuth2",
        "options": {}
      },
      "name": "Gmail로_메일_발송",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "id": "3"
    },
    {
      "parameters": {
        "operation": "update",
        "collection": "influencer_contacts",
        "document": "={{$node['웹훅_데이터_설정'].json['influencerId']}}",
        "data": {
          "status": "전송 완료",
          "lastUpdate": "={{new Date()}}"
        }
      },
      "name": "Firestore_상태_업데이트",
      "type": "n8n-nodes-base.firestore",
      "typeVersion": 1,
      "id": "4"
    }
  ],
  "connections": {
    "시작_웹훅": {
      "main": [
        [
          {
            "node": "웹훅_데이터_설정",
            "type": "main"
          }
        ]
      ]
    },
    "웹훅_데이터_설정": {
      "main": [
        [
          {
            "node": "Gmail로_메일_발송",
            "type": "main"
          }
        ]
      ]
    },
    "Gmail로_메일_발송": {
      "main": [
        [
          {
            "node": "Firestore_상태_업데이트",
            "type": "main"
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
