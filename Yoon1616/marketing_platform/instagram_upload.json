{
    "name": "Instagram AI Auto Post",
    "nodes": [
      {
        "parameters": {
          "path": "generate-post",
          "method": "POST",
          "responseMode": "lastNode",
          "options": {}
        },
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [250, 300]
      },
      {
        "parameters": {
          "model": "gpt-4o-mini",
          "messages": [
            {
              "role": "system",
              "content": "당신은 한국어 SNS 마케팅 전문가입니다. 인스타그램에 올릴 제품 홍보용 포스팅과 해시태그를 만들어주세요. 짧고 직관적이며, 브랜드 톤에 맞고 클릭 유도(Call To Action) 포함."
            },
            {
              "role": "user",
              "content": "제품명: {{$json[\"product_name\"]}}\n카테고리: {{$json[\"category\"]}}\nUSP: {{$json[\"usp\"]}}\n타겟 독자: {{$json[\"target_audience\"]}}\n브랜드 톤: {{$json[\"tone\"]}}\n핵심 키워드: {{$json[\"keywords\"].join(\", \")}}\n권장 CTA: {{$json[\"cta\"]}}\n\n출력 형식:\n[POST_TEXT] 인스타그램 본문\n[HASHTAGS] 10~15개 해시태그"
            }
          ],
          "maxTokens": 600,
          "temperature": 0.7
        },
        "name": "OpenAI GPT",
        "type": "n8n-nodes-base.openai",
        "typeVersion": 1,
        "position": [500, 300],
        "credentials": {
          "openAIApi": "OpenAI API"
        }
      },
      {
        "parameters": {
          "functionCode": "const content = $json[\"choices\"][0][\"message\"][\"content\"];\n\nfunction extract(block) {\n  const start = content.indexOf(`[${block}]`);\n  const end = content.indexOf(`[/${block}]`);\n  if(start === -1 || end === -1) return \"\";\n  return content.substring(start + block.length + 2, end).trim();\n}\n\nreturn [{\n  json: {\n    post_text: extract(\"POST_TEXT\"),\n    hashtags: extract(\"HASHTAGS\"),\n    image_url: \"https://example.com/product_image.jpg\" // 실제 이미지 URL\n  }\n}];"
        },
        "name": "Format AI Output",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [750, 300]
      },
      {
        "parameters": {
          "requestMethod": "POST",
          "url": "https://graph.facebook.com/v17.0/{{INSTAGRAM_USER_ID}}/media",
          "jsonParameters": true,
          "options": {},
          "bodyParametersJson": "{\n  \"image_url\": \"={{$json[\"image_url\"]}}\",\n  \"caption\": \"={{$json[\"post_text\"]}}\\n{{$json[\"hashtags\"]}}\",\n  \"access_token\": \"{{INSTAGRAM_ACCESS_TOKEN}}\"\n}"
        },
        "name": "Instagram Create Media",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 1,
        "position": [1000, 250]
      },
      {
        "parameters": {
          "requestMethod": "POST",
          "url": "https://graph.facebook.com/v17.0/{{INSTAGRAM_USER_ID}}/media_publish",
          "jsonParameters": true,
          "options": {},
          "bodyParametersJson": "{\n  \"creation_id\": \"={{$node[\"Instagram Create Media\"].json[\"id\"]}}\",\n  \"access_token\": \"{{INSTAGRAM_ACCESS_TOKEN}}\"\n}"
        },
        "name": "Instagram Publish Media",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 1,
        "position": [1250, 300]
      }
    ],
    "connections": {
      "Webhook": {
        "main": [
          [
            {
              "node": "OpenAI GPT",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "OpenAI GPT": {
        "main": [
          [
            {
              "node": "Format AI Output",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Format AI Output": {
        "main": [
          [
            {
              "node": "Instagram Create Media",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Instagram Create Media": {
        "main": [
          [
            {
              "node": "Instagram Publish Media",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }
  