{
    "name": "AI Instagram Carousel Multi-Product",
    "nodes": [
      {
        "parameters": {
          "path": "generate-multi-carousel-post",
          "method": "POST",
          "responseMode": "lastNode"
        },
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [200, 300]
      },
      {
        "parameters": {
          "functionCode": "// 입력 받은 멀티 제품 배열 분리\nreturn $json[\"products\"].map(product => ({ json: product }));"
        },
        "name": "Split Products",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [450, 300]
      },
      {
        "parameters": {
          "functionCode": "// 각 제품 이미지 배열 분리\nreturn $json[\"images\"].map(img => ({ json: { ...$json, image_path: img } }));"
        },
        "name": "Split Images",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [650, 300]
      },
      {
        "parameters": {
          "functionCode": "const fs = require('fs');\nconst imageBase64 = fs.readFileSync($json[\"image_path\"], { encoding: 'base64' });\nreturn [{ json: { ...$json, image_base64: imageBase64 } }];"
        },
        "name": "Convert Image to Base64",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [850, 300]
      },
      {
        "parameters": {
          "requestMethod": "POST",
          "url": "https://api.imgur.com/3/image",
          "jsonParameters": true,
          "bodyParametersJson": "{ \"image\": \"={{$json[\"image_base64\"]}}\" }",
          "options": {
            "headers": {
              "Authorization": "Client-ID {{IMGUR_CLIENT_ID}}"
            }
          }
        },
        "name": "Upload Image to Imgur",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 1,
        "position": [1050, 300]
      },
      {
        "parameters": {
          "model": "gpt-4o-mini",
          "messages": [
            {
              "role": "system",
              "content": "당신은 한국어 SNS 마케팅 전문가입니다. 인스타그램에 올릴 제품 홍보용 포스팅과 해시태그를 만들어주세요."
            },
            {
              "role": "user",
              "content": "제품명: {{$json[\"product_name\"]}}\n카테고리: {{$json[\"category\"]}}\nUSP: {{$json[\"usp\"]}}\n타겟: {{$json[\"target_audience\"]}}\n브랜드 톤: {{$json[\"tone\"]}}\n핵심 키워드: {{$json[\"keywords\"].join(\", \")}}\n권장 CTA: {{$json[\"cta\"]}}\n출력: [POST_TEXT] 본문, [HASHTAGS] 해시태그"
            }
          ],
          "maxTokens": 300,
          "temperature": 0.7
        },
        "name": "OpenAI GPT",
        "type": "n8n-nodes-base.openai",
        "typeVersion": 1,
        "position": [1250, 300],
        "credentials": { "openAIApi": "OpenAI API" }
      },
      {
        "parameters": {
          "functionCode": "const content = $json[\"choices\"][0][\"message\"][\"content\"];\nfunction extract(block){const start=content.indexOf(`[${block}]`);const end=content.indexOf(`[/${block}]`);if(start===-1||end===-1)return\"\";\nreturn content.substring(start+block.length+2,end).trim();}\nreturn [{json:{post_text:extract(\"POST_TEXT\"), hashtags:extract(\"HASHTAGS\"), image_url:$node[\"Upload Image to Imgur\"].json[\"data\"][\"link\"]}}];"
        },
        "name": "Format AI Output",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [1450, 300]
      },
      {
        "parameters": {
          "requestMethod": "POST",
          "url": "https://graph.facebook.com/v17.0/{{INSTAGRAM_USER_ID}}/media",
          "jsonParameters": true,
          "bodyParametersJson": "{ \"image_url\": \"={{$json[\"image_url\"]}}\", \"is_carousel_item\": true, \"access_token\": \"{{INSTAGRAM_ACCESS_TOKEN}}\" }"
        },
        "name": "Create Carousel Item",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 1,
        "position": [1650, 300]
      },
      {
        "parameters": {
          "functionCode": "// 각 제품의 carousel item ID 수집\nreturn [{json:{children_ids: $items().map(item => item.json.id), post_text: $items()[0].json.post_text, hashtags: $items()[0].json.hashtags}}];"
        },
        "name": "Prepare Carousel",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [1850, 300]
      },
      {
        "parameters": {
          "requestMethod": "POST",
          "url": "https://graph.facebook.com/v17.0/{{INSTAGRAM_USER_ID}}/media",
          "jsonParameters": true,
          "bodyParametersJson": "{ \"children\": \"={{$json[\"children_ids\"]}}\", \"caption\": \"={{$json[\"post_text\"]}}\\n{{$json[\"hashtags\"]}}\", \"access_token\": \"{{INSTAGRAM_ACCESS_TOKEN}}\" }"
        },
        "name": "Create Main Carousel",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 1,
        "position": [2050, 300]
      },
      {
        "parameters": {
          "requestMethod": "POST",
          "url": "https://graph.facebook.com/v17.0/{{INSTAGRAM_USER_ID}}/media_publish",
          "jsonParameters": true,
          "bodyParametersJson": "{ \"creation_id\": \"={{$node[\"Create Main Carousel\"].json.id}}\", \"access_token\": \"{{INSTAGRAM_ACCESS_TOKEN}}\" }"
        },
        "name": "Publish Carousel",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 1,
        "position": [2250, 300]
      }
    ],
    "connections": {
      "Webhook": { "main": [[{"node": "Split Products","type":"main","index":0}]] },
      "Split Products": { "main": [[{"node": "Split Images","type":"main","index":0}]] },
      "Split Images": { "main": [[{"node": "Convert Image to Base64","type":"main","index":0}]] },
      "Convert Image to Base64": { "main": [[{"node": "Upload Image to Imgur","type":"main","index":0}]] },
      "Upload Image to Imgur": { "main": [[{"node": "OpenAI GPT","type":"main","index":0}]] },
      "OpenAI GPT": { "main": [[{"node": "Format AI Output","type":"main","index":0}]] },
      "Format AI Output": { "main": [[{"node": "Create Carousel Item","type":"main","index":0}]] },
      "Create Carousel Item": { "main": [[{"node": "Prepare Carousel","type":"main","index":0}]] },
      "Prepare Carousel": { "main": [[{"node": "Create Main Carousel","type":"main","index":0}]] },
      "Create Main Carousel": { "main": [[{"node": "Publish Carousel","type":"main","index":0}]] }
    }
  }
  