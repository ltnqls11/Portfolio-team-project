# 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_platform
# 개발용 SQLite (개발 시 사용)
# DATABASE_URL=sqlite:///./marketing_platform.db

# API Keys
OPENAI_API_KEY=your-openai-api-key
APIFY_API_TOKEN=your-apify-token
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# N8N Configuration (자동화 워크플로우)
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Instagram Configuration (주의: 레이트 리밋 고려)
INSTAGRAM_USERNAME=your-instagram-username
INSTAGRAM_PASSWORD=your-instagram-password
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# Application Settings
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=true
ENVIRONMENT=development
PORT=8000

# Redis (캐싱 및 큐)
REDIS_URL=redis://localhost:6379/0

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting & Crawling
RATE_LIMIT_PER_MINUTE=60
CRAWL_DELAY_SECONDS=2
MAX_CRAWLING_PAGES=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Copy Generation
MAX_COPY_VARIANTS=5
DEFAULT_COPY_TONE=professional
