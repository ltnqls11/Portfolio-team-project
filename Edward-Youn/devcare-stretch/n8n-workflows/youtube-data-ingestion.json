{\n  \"name\": \"DevCare Stretch - YouTube Data Ingestion\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"rule\": {\n          \"interval\": [\n            {\n              \"field\": \"cronExpression\",\n              \"expression\": \"0 6 * * *\"\n            }\n          ]\n        }\n      },\n      \"id\": \"cron-trigger\",\n      \"name\": \"Daily 6AM KST\",\n      \"type\": \"n8n-nodes-base.cron\",\n      \"typeVersion\": 1,\n      \"position\": [240, 300]\n    },\n    {\n      \"parameters\": {\n        \"functionCode\": \"// 증상별 키워드 리스트\\nconst symptoms = [\\n  '거북목',\\n  '라운드숄더',\\n  '허리통증',\\n  '손목통증',\\n  '목통증'\\n];\\n\\nreturn symptoms.map(symptom => ({\\n  json: {\\n    symptom: symptom,\\n    searchQuery: `${symptom} 운동 스트레칭 치료`\\n  }\\n}));\"\n      },\n      \"id\": \"symptom-keywords\",\n      \"name\": \"Generate Keywords\",\n      \"type\": \"n8n-nodes-base.function\",\n      \"typeVersion\": 1,\n      \"position\": [460, 300]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"https://www.googleapis.com/youtube/v3/search\",\n        \"options\": {\n          \"queryParameters\": {\n            \"parameters\": [\n              {\n                \"name\": \"key\",\n                \"value\": \"={{$env.YOUTUBE_API_KEY}}\"\n              },\n              {\n                \"name\": \"q\",\n                \"value\": \"={{$json.searchQuery}}\"\n              },\n              {\n                \"name\": \"part\",\n                \"value\": \"snippet\"\n              },\n              {\n                \"name\": \"type\",\n                \"value\": \"video\"\n              },\n              {\n                \"name\": \"maxResults\",\n                \"value\": \"30\"\n              },\n              {\n                \"name\": \"order\",\n                \"value\": \"relevance\"\n              },\n              {\n                \"name\": \"regionCode\",\n                \"value\": \"KR\"\n              },\n              {\n                \"name\": \"relevanceLanguage\",\n                \"value\": \"ko\"\n              }\n            ]\n          }\n        }\n      },\n      \"id\": \"youtube-search\",\n      \"name\": \"YouTube Search\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 1,\n      \"position\": [680, 300]\n    },\n    {\n      \"parameters\": {\n        \"functionCode\": \"// Extract video IDs from search results\\nconst items = $input.all();\\nconst allVideos = [];\\n\\nfor (const item of items) {\\n  const searchResults = item.json.items || [];\\n  const symptom = item.json.symptom;\\n  \\n  for (const video of searchResults) {\\n    allVideos.push({\\n      videoId: video.id.videoId,\\n      title: video.snippet.title,\\n      description: video.snippet.description,\\n      thumbnail: video.snippet.thumbnails.medium.url,\\n      channelTitle: video.snippet.channelTitle,\\n      publishedAt: video.snippet.publishedAt,\\n      symptom: symptom\\n    });\\n  }\\n}\\n\\n// Group video IDs for batch processing\\nconst videoIds = allVideos.map(v => v.videoId);\\nconst chunks = [];\\nfor (let i = 0; i < videoIds.length; i += 50) {\\n  chunks.push({\\n    videoIds: videoIds.slice(i, i + 50).join(','),\\n    videos: allVideos.slice(i, i + 50)\\n  });\\n}\\n\\nreturn chunks.map(chunk => ({ json: chunk }));\"\n      },\n      \"id\": \"process-videos\",\n      \"name\": \"Process Video Results\",\n      \"type\": \"n8n-nodes-base.function\",\n      \"typeVersion\": 1,\n      \"position\": [900, 300]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"https://www.googleapis.com/youtube/v3/videos\",\n        \"options\": {\n          \"queryParameters\": {\n            \"parameters\": [\n              {\n                \"name\": \"key\",\n                \"value\": \"={{$env.YOUTUBE_API_KEY}}\"\n              },\n              {\n                \"name\": \"id\",\n                \"value\": \"={{$json.videoIds}}\"\n              },\n              {\n                \"name\": \"part\",\n                \"value\": \"snippet,contentDetails,statistics\"\n              }\n            ]\n          }\n        }\n      },\n      \"id\": \"video-details\",\n      \"name\": \"Get Video Details\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 1,\n      \"position\": [1120, 300]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{$env.BACKEND_URL}}/api/youtube/bulk-process\",\n        \"options\": {\n          \"headers\": {\n            \"parameters\": [\n              {\n                \"name\": \"Content-Type\",\n                \"value\": \"application/json\"\n              }\n            ]\n          },\n          \"body\": {\n            \"values\": {\n              \"videoData\": \"={{$json}}\"\n            }\n          }\n        },\n        \"method\": \"POST\"\n      },\n      \"id\": \"save-to-backend\",\n      \"name\": \"Save to Backend\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 1,\n      \"position\": [1340, 300]\n    }\n  ],\n  \"connections\": {\n    \"Daily 6AM KST\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Generate Keywords\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Generate Keywords\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"YouTube Search\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"YouTube Search\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Process Video Results\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Process Video Results\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Get Video Details\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Get Video Details\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Save to Backend\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"timezone\": \"Asia/Seoul\"\n  },\n  \"tags\": []\n}"