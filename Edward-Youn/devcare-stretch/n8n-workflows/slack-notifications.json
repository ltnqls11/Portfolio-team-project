{\n  \"name\": \"DevCare Stretch - Slack Notifications\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"path\": \"/webhook/slack-schedule\",\n        \"options\": {\n          \"noResponseBody\": true\n        }\n      },\n      \"id\": \"webhook-trigger\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [240, 300]\n    },\n    {\n      \"parameters\": {\n        \"functionCode\": \"// Extract user data and routine settings from webhook\\nconst data = $json.body;\\n\\nconst user = {\\n  id: data.userId,\\n  name: data.userName,\\n  slackId: data.slackId\\n};\\n\\nconst routine = {\\n  timeSlots: data.timeSlots || ['morning'],\\n  weekdays: data.weekdays || [1,2,3,4,5],\\n  sessionDuration: data.sessionDuration || 30,\\n  exercises: data.exercises || []\\n};\\n\\nconst timeSlotMap = {\\n  morning: '09:00',\\n  lunch: '12:00',\\n  evening: '18:00'\\n};\\n\\n// Generate schedule times for next week\\nconst schedules = [];\\nconst now = new Date();\\n\\nfor (const timeSlot of routine.timeSlots) {\\n  const time = timeSlotMap[timeSlot];\\n  if (!time) continue;\\n  \\n  const [hour, minute] = time.split(':').map(Number);\\n  \\n  for (const weekday of routine.weekdays) {\\n    const targetDate = new Date(now);\\n    const currentDay = now.getDay();\\n    const daysUntil = (weekday - currentDay + 7) % 7 || 7;\\n    \\n    targetDate.setDate(now.getDate() + daysUntil);\\n    targetDate.setHours(hour, minute, 0, 0);\\n    \\n    schedules.push({\\n      user,\\n      routine,\\n      timeSlot,\\n      scheduledTime: Math.floor(targetDate.getTime() / 1000),\\n      scheduledTimeISO: targetDate.toISOString()\\n    });\\n  }\\n}\\n\\nreturn schedules.map(schedule => ({ json: schedule }));\"\n      },\n      \"id\": \"process-schedule\",\n      \"name\": \"Process Schedule Data\",\n      \"type\": \"n8n-nodes-base.function\",\n      \"typeVersion\": 1,\n      \"position\": [460, 300]\n    },\n    {\n      \"parameters\": {\n        \"functionCode\": \"// Create Slack message blocks for workout reminder\\nconst { user, routine, timeSlot } = $json;\\n\\nconst message = {\\n  channel: user.slackId,\\n  text: `${user.name}님, 운동 시간입니다! 💪`,\\n  blocks: [\\n    {\\n      type: \\\"header\\\",\\n      text: {\\n        type: \\\"plain_text\\\",\\n        text: `🏃‍♂️ ${user.name}님의 운동 시간입니다!`\\n      }\\n    },\\n    {\\n      type: \\\"section\\\",\\n      text: {\\n        type: \\\"mrkdwn\\\",\\n        text: `오늘의 추천 운동 (${routine.sessionDuration}분 세션):`\\n      }\\n    },\\n    {\\n      type: \\\"section\\\",\\n      text: {\\n        type: \\\"mrkdwn\\\",\\n        text: routine.exercises.slice(0, 3).map((exercise, index) => \\n          `${index + 1}. *${exercise.title}* (${Math.floor(exercise.duration / 60)}:${(exercise.duration % 60).toString().padStart(2, '0')})`\\n        ).join('\\\\n') || \\\"맞춤 운동을 준비 중입니다...\\\"\\n      }\\n    },\\n    {\\n      type: \\\"actions\\\",\\n      elements: [\\n        {\\n          type: \\\"button\\\",\\n          text: {\\n            type: \\\"plain_text\\\",\\n            text: \\\"🚀 시작하기\\\"\\n          },\\n          style: \\\"primary\\\",\\n          action_id: \\\"workout_start\\\",\\n          value: JSON.stringify({ exercises: routine.exercises.slice(0, 3) })\\n        },\\n        {\\n          type: \\\"button\\\",\\n          text: {\\n            type: \\\"plain_text\\\",\\n            text: \\\"⏰ 10분 후\\\"\\n          },\\n          action_id: \\\"workout_snooze\\\",\\n          value: \\\"10\\\"\\n        },\\n        {\\n          type: \\\"button\\\",\\n          text: {\\n            type: \\\"plain_text\\\",\\n            text: \\\"✅ 완료\\\"\\n          },\\n          style: \\\"danger\\\",\\n          action_id: \\\"workout_complete\\\",\\n          value: \\\"skip\\\"\\n        }\\n      ]\\n    }\\n  ]\\n};\\n\\nreturn { json: { ...message, scheduledTime: $json.scheduledTime } };\"\n      },\n      \"id\": \"create-message\",\n      \"name\": \"Create Slack Message\",\n      \"type\": \"n8n-nodes-base.function\",\n      \"typeVersion\": 1,\n      \"position\": [680, 300]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"https://slack.com/api/chat.scheduleMessage\",\n        \"options\": {\n          \"headers\": {\n            \"parameters\": [\n              {\n                \"name\": \"Authorization\",\n                \"value\": \"Bearer {{$env.SLACK_BOT_TOKEN}}\"\n              },\n              {\n                \"name\": \"Content-Type\",\n                \"value\": \"application/json\"\n              }\n            ]\n          },\n          \"body\": {\n            \"values\": {\n              \"channel\": \"={{$json.channel}}\",\n              \"text\": \"={{$json.text}}\",\n              \"blocks\": \"={{$json.blocks}}\",\n              \"post_at\": \"={{$json.scheduledTime}}\"\n            }\n          }\n        },\n        \"method\": \"POST\"\n      },\n      \"id\": \"schedule-slack-message\",\n      \"name\": \"Schedule Slack Message\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 1,\n      \"position\": [900, 300]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{$env.BACKEND_URL}}/api/slack/schedule-confirmation\",\n        \"options\": {\n          \"headers\": {\n            \"parameters\": [\n              {\n                \"name\": \"Content-Type\",\n                \"value\": \"application/json\"\n              }\n            ]\n          },\n          \"body\": {\n            \"values\": {\n              \"userId\": \"={{$json.user.id}}\",\n              \"scheduleResults\": \"={{$json}}\",\n              \"status\": \"scheduled\"\n            }\n          }\n        },\n        \"method\": \"POST\"\n      },\n      \"id\": \"log-schedule\",\n      \"name\": \"Log Schedule Result\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 1,\n      \"position\": [1120, 300]\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Process Schedule Data\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Process Schedule Data\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create Slack Message\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create Slack Message\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Schedule Slack Message\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Schedule Slack Message\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Log Schedule Result\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"timezone\": \"Asia/Seoul\"\n  },\n  \"tags\": []\n}"