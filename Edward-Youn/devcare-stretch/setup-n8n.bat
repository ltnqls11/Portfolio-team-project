@echo off\nchcp 65001 >nul\nsetlocal enabledelayedexpansion\n\necho ═══════════════════════════════════════════════════════════════\necho 🚀 DevCare Stretch - n8n 자동화 플랫폼 설정\necho ═══════════════════════════════════════════════════════════════\necho.\n\nREM 색상 정의\nset \"RED=[91m\"\nset \"GREEN=[92m\"\nset \"YELLOW=[93m\"\nset \"BLUE=[94m\"\nset \"NC=[0m\"\n\nREM Docker 설치 확인\necho %BLUE%[INFO]%NC% Docker 설치 상태를 확인합니다...\ndocker --version >nul 2>&1\nif %errorlevel% neq 0 (\n    echo %RED%[ERROR]%NC% Docker가 설치되어 있지 않습니다.\n    echo Docker 설치 가이드: https://docs.docker.com/desktop/windows/\n    pause\n    exit /b 1\n)\n\ndocker-compose --version >nul 2>&1\nif %errorlevel% neq 0 (\n    echo %RED%[ERROR]%NC% Docker Compose가 설치되어 있지 않습니다.\n    echo Docker Desktop을 설치하면 자동으로 포함됩니다.\n    pause\n    exit /b 1\n)\n\necho %GREEN%[SUCCESS]%NC% Docker 및 Docker Compose가 설치되어 있습니다.\necho.\n\nREM 환경 변수 파일 설정\necho %BLUE%[INFO]%NC% 환경 변수 파일을 설정합니다...\nif not exist \".env\" (\n    echo %BLUE%[INFO]%NC% n8n.env.example을 .env로 복사합니다...\n    copy n8n.env.example .env >nul\n    echo %YELLOW%[WARNING]%NC% ⚠️  .env 파일을 편집하여 실제 API 키들을 입력해주세요!\n    echo    편집할 파일: %cd%\\.env\n    echo.\n    echo    필요한 API 키들:\n    echo    - YOUTUBE_API_KEY (Google Cloud Console)\n    echo    - OPENAI_API_KEY (OpenAI Platform)\n    echo    - GEMINI_API_KEY (Google AI Studio)\n    echo    - SLACK_BOT_TOKEN (Slack App)\n    echo    - SLACK_SIGNING_SECRET (Slack App)\n    echo    - SUPABASE_URL (Supabase Dashboard)\n    echo    - SUPABASE_SERVICE_KEY (Supabase Dashboard)\n    echo.\n    echo .env 파일을 메모장으로 열어서 편집하시겠습니까?\n    choice /c yn /m \"[Y]es / [N]o\"\n    if !errorlevel! equ 1 (\n        notepad .env\n    )\n    echo.\n    echo API 키 설정을 완료했습니까?\n    choice /c yn /m \"[Y]es / [N]o\"\n    if !errorlevel! equ 2 (\n        echo %YELLOW%[WARNING]%NC% API 키 설정을 완료한 후 다시 실행해주세요.\n        pause\n        exit /b 1\n    )\n) else (\n    echo %GREEN%[SUCCESS]%NC% .env 파일이 이미 존재합니다.\n)\necho.\n\nREM n8n 컨테이너 시작\necho %BLUE%[INFO]%NC% n8n 컨테이너를 시작합니다...\n\nREM 기존 컨테이너 정리\ndocker-compose -f docker-compose.n8n.yml down >nul 2>&1\n\nREM 새 컨테이너 시작\ndocker-compose -f docker-compose.n8n.yml up -d\nif %errorlevel% neq 0 (\n    echo %RED%[ERROR]%NC% n8n 시작에 실패했습니다.\n    echo 로그를 확인해보세요:\n    echo docker-compose -f docker-compose.n8n.yml logs\n    pause\n    exit /b 1\n)\n\necho %BLUE%[INFO]%NC% n8n이 시작되기를 기다립니다...\ntimeout /t 15 /nobreak >nul\n\nREM 컨테이너 상태 확인\ndocker-compose -f docker-compose.n8n.yml ps | findstr \"Up\" >nul\nif %errorlevel% equ 0 (\n    echo %GREEN%[SUCCESS]%NC% n8n이 성공적으로 시작되었습니다!\n    echo.\n    echo 🌐 n8n 웹 인터페이스: http://localhost:5678\n    echo 👤 사용자명: admin\n    echo 🔐 비밀번호: devcare2024!\n    echo.\n) else (\n    echo %RED%[ERROR]%NC% n8n 시작에 실패했습니다.\n    echo 로그를 확인해보세요:\n    echo docker-compose -f docker-compose.n8n.yml logs\n    pause\n    exit /b 1\n)\n\nREM 워크플로우 가이드 출력\necho 📋 다음 단계: 워크플로우 Import\necho ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\necho 1. 브라우저에서 http://localhost:5678 접속\necho 2. admin / devcare2024! 로 로그인\necho 3. 좌측 메뉴에서 'Workflows' 클릭\necho 4. 'Import from file' 버튼 클릭\necho 5. 다음 파일들을 순서대로 import:\necho    📁 n8n-workflows\\youtube-data-ingestion.json\necho    📁 n8n-workflows\\slack-notifications.json\necho 6. 각 워크플로우를 열어서 'Active' 토글 켜기\necho 7. 'Save' 버튼 클릭\necho.\necho 📖 상세한 설정 가이드: docs\\n8n-setup-guide.md\necho.\necho %GREEN%[SUCCESS]%NC% n8n 설정이 완료되었습니다! 🎉\necho.\necho n8n 웹 인터페이스를 브라우저에서 열까요?\nchoice /c yn /m \"[Y]es / [N]o\"\nif !errorlevel! equ 1 (\n    start http://localhost:5678\n)\n\necho.\necho 유용한 명령어들:\necho - n8n 중지: docker-compose -f docker-compose.n8n.yml down\necho - n8n 로그 확인: docker-compose -f docker-compose.n8n.yml logs -f\necho - n8n 재시작: docker-compose -f docker-compose.n8n.yml restart\necho.\npause"