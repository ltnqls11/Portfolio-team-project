# n8n 환경 변수 템플릿\n# 이 파일을 .env로 복사하고 실제 값들을 입력하세요\n\n# ===========================================\n# n8n 기본 설정\n# ===========================================\nN8N_BASIC_AUTH_USER=admin\nN8N_BASIC_AUTH_PASSWORD=devcare2024!\nN8N_HOST=localhost\nN8N_PORT=5678\nWEBHOOK_URL=http://localhost:5678\n\n# ===========================================\n# YouTube Data API v3\n# ===========================================\n# Google Cloud Console에서 발급\n# https://console.cloud.google.com\nYOUTUBE_API_KEY=your_youtube_api_key_here\n\n# ===========================================\n# OpenAI API\n# ===========================================\n# OpenAI Platform에서 발급\n# https://platform.openai.com\nOPENAI_API_KEY=your_openai_api_key_here\n\n# ===========================================\n# Google Gemini API\n# ===========================================\n# Google AI Studio에서 발급\n# https://aistudio.google.com\nGEMINI_API_KEY=your_gemini_api_key_here\n\n# ===========================================\n# Slack API\n# ===========================================\n# Slack App 생성 후 발급\n# https://api.slack.com/apps\nSLACK_BOT_TOKEN=xoxb-your-slack-bot-token\nSLACK_SIGNING_SECRET=your_slack_signing_secret\n\n# ===========================================\n# Backend API\n# ===========================================\n# DevCare Stretch 백엔드 서버 URL\nBACKEND_URL=http://host.docker.internal:5000\n\n# ===========================================\n# Supabase 설정\n# ===========================================\n# Supabase 프로젝트에서 복사\n# https://supabase.com\nSUPABASE_URL=https://your-project.supabase.co\nSUPABASE_SERVICE_KEY=your_supabase_service_key\n\n# ===========================================\n# 선택적 설정\n# ===========================================\n# 타임존 설정\nGENERIC_TIMEZONE=Asia/Seoul\n\n# 로그 레벨 (error, warn, info, verbose, debug, silly)\nN8N_LOG_LEVEL=info\n\n# 워크플로우 실행 모드\nN8N_EXECUTION_MODE=main"