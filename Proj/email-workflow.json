{
    "name": "블로거 마케팅 이메일 발송",
    "nodes": [
      {
        "parameters": {},
        "name": "Start",
        "type": "n8n-nodes-base.start",
        "typeVersion": 1,
        "position": [
          250,
          300
        ]
      },
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "webhook-email-start",
          "options": {
            "noResponseBody": false
          }
        },
        "name": "[1] React에서 실행",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [
          450,
          300
        ],
        "webhookId": "YOUR_WEBHOOK_ID_WILL_BE_GENERATED_HERE"
      },
      {
        "parameters": {
          "operation": "read",
          "documentId": "={{$json.body.sheet_id}}",
          "sheetName": "={{$json.body.sheet_name}}",
          "options": {
            "valueRenderOption": "UNFORMATTED_VALUE"
          }
        },
        "name": "[2] 구글 시트 읽기",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 3,
        "position": [
          650,
          300
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "YOUR_GOOGLE_CREDENTIAL_ID",
            "name": "Google Sheets Credential"
          }
        }
      },
      {
        "parameters": {
          "batchSize": 1,
          "options": {}
        },
        "name": "[3] 블로거별로 분할",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 2,
        "position": [
          850,
          300
        ]
      },
      {
        "parameters": {
          "values": {
            "string": [
              {
                "name": "email_subject",
                "value": "={{$json.블로그명}} 블로거님, 특별한 마케팅 제휴를 제안합니다."
              },
              {
                "name": "email_body",
                "value": "안녕하세요, {{$json.블로그명}}님!\n\n저희는 이번에 새로 출시한 '{{$startNode.json.body.productName}}' 제품의 홍보를 함께할 파트너를 찾고 있습니다.\n블로거님의 전문성 있는 리뷰는 저희 제품에 큰 도움이 될 것입니다.\n\n긍정적으로 검토 부탁드립니다.\n감사합니다."
              }
            ]
          },
          "options": {}
        },
        "name": "[4] 이메일 내용 생성",
        "type": "n8n-nodes-base.set",
        "typeVersion": 2,
        "position": [
          1050,
          300
        ]
      },
      {
        "parameters": {
          "to": "={{$json.이메일}}",
          "subject": "={{$parent.nodes['[4] 이메일 내용 생성'].json.email_subject}}",
          "text": "={{$parent.nodes['[4] 이메일 내용 생성'].json.email_body}}"
        },
        "name": "[5] Gmail 발송",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 3,
        "position": [
          1250,
          300
        ],
        "credentials": {
          "gmailOAuth2Api": {
            "id": "YOUR_GMAIL_CREDENTIAL_ID",
            "name": "Gmail Credential"
          }
        }
      }
    ],
    "connections": {
      "[1] React에서 실행": {
        "main": [
          [
            {
              "node": "[2] 구글 시트 읽기",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "[2] 구글 시트 읽기": {
        "main": [
          [
            {
              "node": "[3] 블로거별로 분할",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "[3] 블로거별로 분할": {
        "main": [
          [
            {
              "node": "[4] 이메일 내용 생성",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "[4] 이메일 내용 생성": {
        "main": [
          [
            {
              "node": "[5] Gmail 발송",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }