# Google Sheets API 설정
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_TOKEN_FILE=token.json

# 네이버 API 설정 (카페 포스팅용)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NAVER_CAFE_ID=your_cafe_id_here
NAVER_MENU_ID=your_menu_id_here

# Gmail API 설정
GMAIL_CREDENTIALS_FILE=gmail_credentials.json

# n8n 웹훅 URL 설정
N8N_BASE_URL=http://localhost:5678
N8N_EMAIL_WEBHOOK_ID=webhook-email-start
N8N_CAFE_WEBHOOK_ID=webhook-cafe-post

# API 서버 설정
API_SERVER_HOST=localhost
API_SERVER_PORT=5000

# React 앱 설정
REACT_APP_API_BASE_URL=http://localhost:5000/api

# 브라우저 설정
BROWSER_TIMEOUT=10
PAGE_LOAD_DELAY=2

# 기본 Google Sheets 설정 (선택사항)
DEFAULT_SHEET_ID=
DEFAULT_SHEET_NAME=Sheet1

# 보안 설정
SECRET_KEY=your_secret_key_here_for_flask_sessions