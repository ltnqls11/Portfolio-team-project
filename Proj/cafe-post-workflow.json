{
    "name": "네이버 카페 자동 포스팅",
    "nodes": [
        {
            "parameters": {},
            "name": "Start",
            "type": "n8n-nodes-base.start",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "webhook-cafe-post",
                "options": {}
            },
            "name": "[1] React에서 실행",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                450,
                300
            ],
            "webhookId": "YOUR_WEBHOOK_ID_WILL_BE_GENERATED_HERE"
        },
        {
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "cafe_subject",
                            "value": "[신제품 출시] {{$json.body.productName}}를 소개합니다!"
                        },
                        {
                            "name": "cafe_body",
                            "value": "안녕하세요, 회원 여러분! <br>드디어 저희의 야심작, <b>{{$json.body.productName}}</b>가 출시되었습니다. <br>{{$json.body.eventInfo}}와 같은 특별 이벤트도 진행 중이니 많은 관심 부탁드립니다!"
                        }
                    ]
                },
                "options": {}
            },
            "name": "[2] 카페 게시물 내용 생성",
            "type": "n8n-nodes-base.set",
            "typeVersion": 2,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://openapi.naver.com/v1/cafe/{{$env.NAVER_CAFE_ID}}/menu/{{$env.NAVER_MENU_ID}}/articles",
                "authentication": "oAuth2",
                "sendBody": true,
                "contentType": "multipart-form-data",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "subject",
                            "value": "={{$last.json.cafe_subject}}"
                        },
                        {
                            "name": "content",
                            "value": "={{$last.json.cafe_body}}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "[3] Naver Cafe API 요청",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                850,
                300
            ],
            "credentials": {
                "oAuth2Api": {
                    "id": "YOUR_NAVER_OAUTH2_CREDENTIAL_ID",
                    "name": "Naver OAuth2 Credential"
                }
            }
        }
    ],
    "connections": {
        "[1] React에서 실행": {
            "main": [
                [
                    {
                        "node": "[2] 카페 게시물 내용 생성",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "[2] 카페 게시물 내용 생성": {
            "main": [
                [
                    {
                        "node": "[3] Naver Cafe API 요청",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}