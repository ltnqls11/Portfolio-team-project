{
  "name": "blog-influencer-rpa",
  "version": "1.0.0",
  "description": "Blog Influencer Marketing Automation RPA System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && npm start",
    "scraper:dev": "cd scraper && npm run dev",
    "ml:dev": "cd ml-service && npm run dev",
    "build": "npm run frontend:build && npm run backend:build",
    "frontend:build": "cd frontend && npm run build",
    "backend:build": "cd backend && npm run build",
    "db:setup": "cd backend && npm run db:migrate",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test"
  },
  "keywords": [
    "rpa",
    "influencer",
    "marketing",
    "automation",
    "blog",
    "scraping"
  ],
  "author": "Blog RPA Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}